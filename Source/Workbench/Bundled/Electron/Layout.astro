---
/**
 * Bundled Electron Workbench Layout.
 *
 * Loads the Vite/Astro-bundled entry. Vite resolves `./Entry.ts`
 * through Rollup, hashes the output, and the resulting JS / CSS
 * land under Sky/Target/_astro/workbench-[hash].{js,css}.
 *
 * Boot chain when `Disable !== "true"`:
 *
 *   NLS -> TelemetryBridge -> phase-advance ->
 *   WindPreload -> Polyfills -> Bootstrap (Wind Effect-TS) ->
 *   Entry (bundled workbench) -> InstallSkyBridge
 *
 * Boot chain when `Disable === "true"` (master kill-switch):
 *
 *   NLS -> phase-advance ->
 *   WindPreload (Wind's `window.vscode` shim - workbench panics
 *                without it) ->
 *   Polyfills (the 7 Electron polyfills VS Code reads at module-eval
 *              time - workbench panics without them) ->
 *   Entry (bundled workbench)
 *
 * Bootstrap (Wind's Effect-TS bootstrap), TelemetryBridge, and
 * InstallSkyBridge are all skipped under `Disable=true` so the
 * workbench loads as close to vanilla as our Electron-on-Tauri
 * scaffolding allows. Useful for bisecting whether a regression
 * lives in our customisations or upstream / Tauri / WKWebView.
 *
 * The skip is keyed on `import.meta.env.Disable` (Vite define from
 * `astro.config.ts`) so a build-time `export Disable=true` flips
 * it deterministically; Astro's static rendering means a runtime-
 * only flip cannot reach this scaffolding (the `<script>` tags
 * are emitted at build time).
 */

import NLS from "../../NLS.astro";
import TelemetryBridge from "../../TelemetryBridge.astro";

const Disable =
	(import.meta.env as Record<string, string | undefined>)["Disable"] ===
	"true";
---

<Fragment>
	<NLS />
	{!Disable && <TelemetryBridge />}

	<!-- Phase advance script - fires BEFORE the workbench import so it
	     is not blocked by the main workbench script. Mirrors the
	     equivalent block in `Mountain.astro:30` so the bundled Electron
	     route doesn't hang at phase 2 / 3 waiting for Mountain's 8s /
	     23s fallback timers (visible in the log as
	     `[Lifecycle] [Fallback] Sky did not advance to Restored within
	     8s ...`). The fallback delay leaves the workbench in a
	     half-restored render state - editor state-restoration gated on
	     phase=Restored is deferred, "Eventually" work is deferred -
	     which surfaces as sluggish UI / heavy-on-the-eye flicker
	     during the first 8-23 seconds.

	     Phase advance still fires under Disable=true: phase advancement
	     is Land lifecycle bookkeeping, not a workbench feature. Mountain
	     uses it to flip the window from `visible(false)` to visible. -->
	<script type="module">
		// Resolve the Tauri invoke handle. Two race conditions are at play:
		//   1. ES-module script tags can execute BEFORE the Tauri runtime
		//      has finished injecting `window.__TAURI_INTERNALS__` into the
		//      page (Wry's bridge is a content-script that fires during
		//      document_start, but module evaluation can race ahead under
		//      certain webview / page-load orderings).
		//   2. With patched / forked Tauri builds, the injection may land
		//      on `window.__TAURI__.core.invoke` rather than the
		//      `__TAURI_INTERNALS__` global.
		//
		// Earlier versions of this script gave up immediately when neither
		// was defined - that silenced `lifecycle:advancePhase(3)` and let
		// Mountain's 8s / 23s fallback take over (visible in the log as
		// "Sky did not advance to Restored within 8s"). All editor
		// actions that route through the same `Tauri.invoke` channel
		// (Open Folder, terminal commands, native dialogs) also fail the
		// first time. Retry instead until either the global appears or
		// the 5s budget is exhausted, then log the verdict.
		function ResolveInvoke() {
			return (
				globalThis.__TAURI_INTERNALS__?.invoke ??
				globalThis.__TAURI__?.core?.invoke ??
				globalThis.__TAURI__?.invoke ??
				null
			);
		}

		async function WaitForInvoke(MaxMs = 5000, IntervalMs = 25) {
			const StartedAt = performance.now();
			let Found = ResolveInvoke();
			while (!Found && performance.now() - StartedAt < MaxMs) {
				await new Promise((Resolve) => setTimeout(Resolve, IntervalMs));
				Found = ResolveInvoke();
			}
			return Found;
		}

		(async () => {
			const PhaseInvoke = await WaitForInvoke();
			if (!PhaseInvoke) {
				// eslint-disable-next-line no-console
				console.error(
					"[Bundled/Electron/Layout] Tauri IPC bridge never appeared on window.__TAURI_INTERNALS__ / __TAURI__.{core,}.invoke - every Mountain action (Open Folder, terminal, dialogs, lifecycle) will fail. Mountain's 8s phase fallback will paint the workbench but actions will be no-ops. Likely cause: tauri-runtime-wry / tauri-plugin-localhost mismatch with the loaded URL scheme.",
				);
				performance.mark("land:bundled:electron:tauri-missing");
				return;
			}
			performance.mark("land:bundled:electron:tauri-resolved");
			const Advance = (PhaseNumber) =>
				PhaseInvoke("MountainIPCInvoke", {
					method: "lifecycle:advancePhase",
					params: [PhaseNumber],
				}).catch((Error) => {
					// eslint-disable-next-line no-console
					console.warn(
						`[Bundled/Electron/Layout] advancePhase(${PhaseNumber}) failed:`,
						Error,
					);
				});
			// Phase 3 = Restored: workbench DOM is attached, first
			// paint imminent. Mountain rejects same-/backwards-phase
			// advances, so racing the workbench import is safe.
			Advance(3);
			// Phase 4 = Eventually: long-tail background work can
			// start. Delayed so 3 → 4 stays monotonic.
			setTimeout(() => Advance(4), 1500);
		})();
	</script>

	{
		/*
	  Single boot-chain `<script>` with a build-time conditional. Vite
	  substitutes `import.meta.env.Disable` with the literal string at
	  build time (per `astro.config.ts` `define` block), so the `if`
	  blocks tree-shake cleanly: `Disable=true` builds drop Bootstrap
	  + SkyBridge entirely, `Disable=false` builds drop the
	  disabled-mode mark.

	  Astro's JSX-conditional rendering of `<script>` tags is fragile
	  (Astro hoists / processes `<script>` specially and does not
	  always honour ternary placement), so we keep ONE script and let
	  Vite handle the dead-code elimination instead.

	  WindPreload + Polyfills run unconditionally - VS Code's
	  workbench.js reads `globalThis.process`, `window.vscode`, the
	  Electron-style IPC shim, etc. at module-eval time and crashes
	  without them. They are NOT skippable.
	*/
	}
	<script type="module">
		await import("../../Electron/Wind/Preload.js");
		await import("../../Electron/Polyfills.js");
		if (import.meta.env.Disable !== "true") {
			await import("../../Electron/Bootstrap.js");
		}
		await import("./Entry.js");
		if (import.meta.env.Disable !== "true") {
			try {
				const { InstallSkyBridge } =
					await import("@codeeditorland/sky/Source/Function/Sky/Bridge.js");
				await InstallSkyBridge();
				performance.mark("land:bundled:electron:skybridge:installed");
			} catch (Error) {
				performance.mark("land:bundled:electron:skybridge:error");
				// eslint-disable-next-line no-console
				console.warn(
					"[Bundled/Electron/Layout.astro] InstallSkyBridge failed:",
					Error,
				);
			}
		} else {
			performance.mark("land:bundled:electron:disabled-mode-loaded");
		}
	</script>
</Fragment>
