---
/**
 * Bundled/Electron.astro - Vite/Astro-bundled Electron workbench route.
 *
 * Route: /Bundled/Electron
 *
 * Active when the build profile sets `Pack=Electron` (or
 * `Pack="Electron ..."` for the all-variants pass). `Boot=true`
 * tells the Sky-redirect logic to prefer this route over /Electron
 * for the matching workbench.
 *
 * The route ALWAYS exists - it's gated at module-graph level by Vite's
 * input map in astro.config.ts. When the profile does not bundle the
 * Electron variant, the page renders without the Rollup-emitted entry
 * (the bundled chunk simply isn't produced).
 */

import Layout from "../../Function/Markup/Base.astro";

const BundledList = (process.env["Pack"] ?? "")
	.split(/\s+/)
	.map((Name) => Name.trim().toLowerCase())
	.filter(Boolean);

// Gate the inner Layout import on the active `Pack` so Vite/Rollup walks
// the bundled VS Code module graph only when the profile actually selected
// this variant. Static `import` would force Rollup to follow the chain
// regardless, pulling in gulp-only files (`workbench.desktop.main.js`) that
// the release `out-build/` tree does not carry. See `pages/index.astro`
// frontmatter for the full rationale.
const BundledElectronLayout = BundledList.includes("electron")
	? (await import("../../Workbench/Bundled/Electron/Layout.astro")).default
	: null;
---

<Layout>
	{BundledElectronLayout ? <BundledElectronLayout /> : null}
</Layout>
