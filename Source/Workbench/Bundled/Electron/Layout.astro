---
/**
 * Bundled Electron Workbench Layout.
 *
 * Loads the Vite/Astro-bundled entry. Vite resolves `./Entry.ts`
 * through Rollup, hashes the output, and the resulting JS / CSS
 * land under Sky/Target/_astro/workbench-[hash].{js,css}.
 *
 * Same Preload -> Polyfills -> Bootstrap chain as the non-bundled
 * ../Electron/Layout.astro, only the workbench step is bundled. The
 * chain is required because VS Code's workbench module reads
 * globalThis.process / window.vscode / etc. before its own module
 * code runs - without the polyfills it crashes with
 *   `TypeError: undefined is not an object (evaluating 'p.process')`.
 *
 * SkyBridge is wired after the bundled workbench import resolves so
 * its Tauri event consumers attach before the workbench starts
 * pumping events.
 */

import NLS from "../../NLS.astro";
import TelemetryBridge from "../../TelemetryBridge.astro";
---

<Fragment>
	<NLS />
	<TelemetryBridge />

	<!-- Phase advance script - fires BEFORE the workbench import so it
	     is not blocked by the main workbench script. Mirrors the
	     equivalent block in `Mountain.astro:30` so the bundled Electron
	     route doesn't hang at phase 2 / 3 waiting for Mountain's 8s /
	     23s fallback timers (visible in the log as
	     `[Lifecycle] [Fallback] Sky did not advance to Restored within
	     8s ...`). The fallback delay leaves the workbench in a
	     half-restored render state - editor state-restoration gated on
	     phase=Restored is deferred, "Eventually" work is deferred -
	     which surfaces as sluggish UI / heavy-on-the-eye flicker
	     during the first 8-23 seconds. -->
	<script type="module">
		const PhaseInvoke =
			globalThis.__TAURI_INTERNALS__?.invoke ??
			globalThis.__TAURI__?.invoke ??
			globalThis.__TAURI__?.core?.invoke ??
			null;
		if (PhaseInvoke) {
			const Advance = (PhaseNumber) =>
				PhaseInvoke("MountainIPCInvoke", {
					method: "lifecycle:advancePhase",
					params: [PhaseNumber],
				}).catch(() => {});
			// Phase 3 = Restored: workbench DOM is attached, first
			// paint imminent. Mountain rejects same-/backwards-phase
			// advances, so racing the workbench import is safe.
			Advance(3);
			// Phase 4 = Eventually: long-tail background work can
			// start. Delayed so 3 → 4 stays monotonic.
			setTimeout(() => Advance(4), 1500);
		}
	</script>

	<!-- Sequential: Preload -> Polyfills -> Bootstrap -> Entry (bundled workbench) -> SkyBridge -->
	<script type="module">
		await import("../../Electron/WindPreload.js");
		await import("../../Electron/Polyfills.js");
		await import("../../Electron/Bootstrap.js");
		await import("./Entry.js");

		try {
			const { InstallSkyBridge } = await import(
				"@codeeditorland/sky/Source/Function/SkyBridge"
			);
			await InstallSkyBridge();
			performance.mark("land:bundled:electron:skybridge:installed");
		} catch (Error) {
			performance.mark("land:bundled:electron:skybridge:error");
			// eslint-disable-next-line no-console
			console.warn("[Bundled/Electron/Layout.astro] InstallSkyBridge failed:", Error);
		}
	</script>
</Fragment>
