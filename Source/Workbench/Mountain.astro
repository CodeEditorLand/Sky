---
/**
 * Mountain.astro - Browser Workbench with Mountain Providers (Approach A2)
 *
 * Uses browser workbench with Wind services + Mountain-backed providers.
 * Normal-path tracing goes through performance.mark(); console.warn is used
 * only when an optional integration is unavailable, so degradation stays
 * visible in the console instead of being recorded solely as a mark.
 */

import NLS from "./NLS.astro";
import TelemetryBridge from "./TelemetryBridge.astro";
---

<Fragment>
	<NLS />
	<TelemetryBridge />

	<!-- Phase Advance - fires BEFORE the workbench import so it is
	     not blocked by the main workbench script and is not wiped
	     by a subsequent Window.navigate() folder-open reload.

	     Mountain broadcasts each phase change over
	     `sky://lifecycle/phaseChanged`; the workbench (once it
	     eventually loads) subscribes and gates long-running work.
	     If Mountain never hears from Sky, its fallback timers fire
	     at +8s (Restored) and +23s (Eventually), which the dev log
	     surfaces as `[Lifecycle] [Fallback] Sky did not advance
	     within ...`. That delay is harmless in the abstract, but it
	     masks real issues and pushes everything gated on phase 3 /
	     4 out by seconds. -->
	<script type="module">
		performance.mark("land:mountain:phase:script:start");
		const PhaseInvoke =
			globalThis.__TAURI_INTERNALS__?.invoke ??
			globalThis.__TAURI__?.invoke ??
			globalThis.__TAURI__?.core?.invoke ??
			null;
		if (!PhaseInvoke) {
			performance.mark("land:mountain:phase:invoke-unavailable");
			console.warn(
				"[Mountain.astro] Tauri invoke not available; phase advance skipped",
			);
		} else {
			// Tauri command `MountainIPCInvoke` signature is
			// `(method: String, params: Value)` - NOT `(command,
			// args)`. Mismatched param names cause silent
			// deserialisation failure and Mountain falls back to its
			// 8s / 23s phase timers. All Wind / Output / astro
			// diagnostic call-sites use `{ method, params }` - this
			// block must match.
			// A failed advance must never be recorded as success. Warn through
			// whatever logger the host exposes - a missing or throwing console.warn
			// must not break the UI path or hide the failure mark.
			const PhaseWarn = (PhaseNumber, Message, Detail) => {
				const Warn =
					globalThis.console?.warn ?? globalThis.console?.log ?? null;
				if (typeof Warn === "function") {
					try {
						Warn(
							`[Mountain.astro] phase ${PhaseNumber}: ${Message}`,
							Detail,
						);
					} catch {
						// logger threw - the error mark below still records it
					}
				}
				try {
					performance.mark(
						`land:mountain:phase:${PhaseNumber}:error`,
					);
				} catch {
					// marking unavailable - degrade silently, never throw
				}
			};
			const Mark = (Name) => {
				try {
					performance.mark(Name);
				} catch {
					// marking unavailable - degrade silently, never throw
				}
			};
			// Resolve true only when Mountain reports the phase is actually at or
			// beyond the request. A rejection, a synchronous throw or a malformed
			// response resolve false so no caller can record a false success.
			const Advance = (PhaseNumber) => {
				let Pending;
				try {
					Pending = PhaseInvoke("MountainIPCInvoke", {
						method: "lifecycle:advancePhase",
						params: [PhaseNumber],
					});
				} catch (Error) {
					PhaseWarn(PhaseNumber, "advancePhase threw", Error);
					return Promise.resolve(false);
				}
				return Promise.resolve(Pending).then(
					(Response) => {
						// lifecycle:advancePhase returns the current phase as a
						// JSON number (>= the request only when it really moved).
						if (
							typeof Response === "number" &&
							Number.isFinite(Response) &&
							Response >= PhaseNumber
						) {
							return true;
						}
						PhaseWarn(
							PhaseNumber,
							"advancePhase returned an unexpected response",
							Response,
						);
						return false;
					},
					(Error) => {
						PhaseWarn(PhaseNumber, "advancePhase failed", Error);
						return false;
					},
				);
			};
			// Phase 3 = Restored: workbench DOM is attached and
			// first-paint is imminent. Fire early - Mountain rejects
			// backwards / same-phase advances, so races are safe.
			Advance(3).then((Succeeded) => {
				if (Succeeded) Mark("land:mountain:phase:restored");
			});
			// Phase 4 = Eventually: long tail background work can
			// start. Delayed so Mountain sees a monotonic 3 → 4
			// progression even if both invokes enqueue near-
			// simultaneously.
			setTimeout(() => {
				Advance(4).then((Succeeded) => {
					if (Succeeded) Mark("land:mountain:phase:eventually");
				});
			}, 1500);
		}
	</script>

	<!-- Wind Preload -->
	<script type="module">
		performance.mark("land:mountain:preload:start");
		try {
			const { default: Install } =
				await import("@codeeditorland/wind/Target/Function/Install/Function/Install");
			await Install();
			performance.mark("land:mountain:preload:done");
			performance.measure(
				"land:mountain:preload",
				"land:mountain:preload:start",
				"land:mountain:preload:done",
			);
		} catch (Error) {
			console.warn(
				"[Mountain.astro] Wind preload import failed; continuing without preload:",
				Error,
			);
			performance.mark("land:mountain:preload:error");
		}
	</script>

	<!-- Wind Bootstrap -->
	<script type="module">
		performance.mark("land:mountain:bootstrap:start");
		try {
			const { runBootstrap } =
				await import("@codeeditorland/wind/Target/Effect/Bootstrap");
			await runBootstrap({ skipHealthCheck: true, debugMode: true });
			performance.mark("land:mountain:bootstrap:done");
		} catch (Error) {
			console.warn(
				"[Mountain.astro] Wind bootstrap import failed; workbench continues without Effect services:",
				Error,
			);
			performance.mark("land:mountain:bootstrap:error");
		}
	</script>

	<!-- Browser Workbench -->
	<script type="module">
		performance.mark("land:mountain:workbench:start");
		try {
			const WorkbenchUrl =
				"/Static/Application/vs/code/browser/workbench/workbench.js";
			await import(WorkbenchUrl);
			performance.mark("land:mountain:workbench:loaded");

			// SkyBridge install is timed after the workbench has a
			// chance to mount - 1s is enough for the first-paint
			// DOM, before the workbench typically fires its folder-
			// open navigate. Phase advance lives in its own script
			// block above so it doesn't depend on this reaching
			// here.
			setTimeout(async () => {
				try {
					const { InstallSkyBridge } =
						await import("../Function/Sky/Bridge.js");
					await InstallSkyBridge();
					performance.mark("land:mountain:skybridge:installed");
				} catch (Error) {
					console.warn(
						"[Mountain.astro] InstallSkyBridge failed:",
						Error,
					);
					performance.mark("land:mountain:skybridge:error");
				}
			}, 1000);
		} catch (Error) {
			console.warn(
				"[Mountain.astro] Browser workbench script failed to load:",
				Error,
			);
			performance.mark("land:mountain:workbench:error");
		}
	</script>
</Fragment>
