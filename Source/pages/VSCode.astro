---
import Layout from "@Source/Function/Markup/Base.astro";

const Site = Astro.site;
const Worker = `/Worker.js?BASE_REMOTE=${encodeURIComponent(Site?.toString() ?? Astro.url.origin)}`;
---

<Layout>
	<meta
		id="vscode-workbench-web-configuration"
		data-settings={JSON.stringify({
			remoteAuthority: Astro.url.host,
			serverBasePath: "/",
			developmentOptions: { logLevel: 3 },
			enableWorkspaceTrust: true,
			productConfiguration: { embedderIdentifier: "server-distro" },
			callbackRoute: "/oss-dev/callback",
		})}
		slot="Head"
	/>

	<script is:inline type="importmap" slot="Head">
		{
			"imports": {
				"vscode": "/Static/Shim/Empty.js"
			}
		}
	</script>

	<script is:inline type="module" define:vars={{ Site }} slot="Head">
		// @ts-expect-error
		globalThis._VSCODE_FILE_ROOT = `${Site}/Static/VSCode/`;
	</script>

	<script is:inline type="module" src="/Worker/CSS/Load.js" slot="Head" defer
	></script>

	<script is:inline type="module" define:vars={{ Worker }} slot="Head">
		// @ts-expect-error
		window._WORKER = Worker;
	</script>

	<script is:inline type="module" src="/Worker/Register.js" slot="Head" defer
	></script>

	<script
		is:inline
		type="module"
		src="/Static/VSCode/vs/code/browser/workbench/workbench.js"
		defer></script>
</Layout>
