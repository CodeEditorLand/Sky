---
/**
 * Mountain.astro - Browser Workbench with Mountain Providers (Approach A2)
 *
 * Uses browser workbench with Wind services + Mountain-backed providers.
 * Zero console.* - all tracing via performance.mark().
 */

import NLS from "./NLS.astro";
import TelemetryBridge from "./TelemetryBridge.astro";
---

<Fragment>
	<NLS />
	<TelemetryBridge />

	<!-- Wind Preload -->
	<script type="module">
		performance.mark("land:mountain:preload:start");
		try {
			const { default: Install } = await import(
				"@codeeditorland/wind/Target/Function/Install/Function/Install"
			);
			await Install();
			performance.mark("land:mountain:preload:done");
			performance.measure(
				"land:mountain:preload",
				"land:mountain:preload:start",
				"land:mountain:preload:done",
			);
		} catch {
			performance.mark("land:mountain:preload:error");
		}
	</script>

	<!-- Wind Effect-TS Bootstrap -->
	<script type="module">
		performance.mark("land:mountain:bootstrap:start");
		try {
			const { runBootstrap } = await import(
				"@codeeditorland/wind/Target/Effect/Bootstrap"
			);
			const { Effect } = await import("effect");
			await Effect.runPromise(
				runBootstrap({ skipHealthCheck: true, debugMode: true }),
			);
			performance.mark("land:mountain:bootstrap:done");
		} catch {
			performance.mark("land:mountain:bootstrap:error");
		}
	</script>

	<!-- Browser Workbench -->
	<script type="module">
		performance.mark("land:mountain:workbench:start");
		try {
			const WorkbenchUrl =
				"/Static/Application/vs/code/browser/workbench/workbench.js";
			await import(WorkbenchUrl);
			performance.mark("land:mountain:workbench:loaded");

			setTimeout(async () => {
				try {
					const { InstallSkyBridge } = await import(
						"@codeeditorland/sky/Source/Function/SkyBridge"
					);
					await InstallSkyBridge();
					performance.mark("land:mountain:skybridge:installed");

					// Atom P3: signal Mountain that the workbench is
					// interactive so `Restored` / `Eventually` phases don't
					// rely on Mountain's 8s/23s fallback timers. Mountain
					// rejects backwards/same-phase advances so calling this
					// after the fallback fired is harmless. The Tauri IPC
					// is loaded dynamically because the workbench boot runs
					// in a plain `<script type="module">` context without a
					// pre-resolved bundle.
					try {
						const TauriModule = await import(
							"@tauri-apps/api/core"
						);
						await TauriModule.invoke("mountain_ipc_invoke", {
							command: "lifecycle:advancePhase",
							args: [3],
						});
						performance.mark("land:mountain:phase:restored");
						setTimeout(async () => {
							try {
								await TauriModule.invoke(
									"mountain_ipc_invoke",
									{
										command: "lifecycle:advancePhase",
										args: [4],
									},
								);
								performance.mark(
									"land:mountain:phase:eventually",
								);
							} catch {
								performance.mark(
									"land:mountain:phase:eventually:error",
								);
							}
						}, 2000);
					} catch {
						performance.mark("land:mountain:phase:error");
					}
				} catch {
					performance.mark("land:mountain:skybridge:error");
				}
			}, 2000);
		} catch {
			performance.mark("land:mountain:workbench:error");
		}
	</script>
</Fragment>
