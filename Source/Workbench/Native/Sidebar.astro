---
/**
 * Sidebar - File Explorer and other panels
 * 
 * Provides sidebar panels for file explorer, search, source control, etc.
 */
---
<div id="wind-sidebar" class="wind-sidebar">
	<div class="wind-sidebar-header">
		<div class="wind-sidebar-title">Explorer</div>
	</div>
	
	<div class="wind-sidebar-content">
		<div id="wind-file-tree" class="wind-file-tree">
			<!-- File tree will be populated by JavaScript -->
		</div>
	</div>
	
	<div class="wind-sidebar-resize-handle"></div>
</div>

<style>
	.wind-sidebar {
		width: 260px;
		height: 100%;
		min-width: 150px;
		max-width: 600px;
		background-color: var(--vscode-sideBar-background);
		border-right: 1px solid var(--vscode-sideBar-border);
		display: flex;
		flex-direction: column;
		position: relative;
	 overflow: hidden;
	}

	.wind-sidebar-header {
		display: flex;
		align-items: center;
		padding: 8px 12px;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: var(--vscode-sideBar-foreground);
		background-color: var(--vscode-sideBarSectionHeader-background);
		border-bottom: 1px solid var(--vscode-sideBar-border);
	}

	.wind-sidebar-title {
		flex: 1;
	}

	.wind-sidebar-content {
		flex: 1;
		overflow-y: auto;
	}

	.wind-file-tree {
		padding: 4px 0;
	}

	.wind-file-item {
		display: flex;
		align-items: center;
		padding: 4px 12px 4px 16px;
		cursor: pointer;
		font-size: 13px;
		white-space: nowrap;
		transition: background-color 0.1s ease;
	}

	.wind-file-item:hover {
		background-color: var(--vscode-list-hoverBackground);
	}

	.wind-file-item.active {
		background-color: var(--vscode-list-activeSelectionBackground);
		color: var(--vscode-list-activeSelectionForeground);
	}

	.wind-file-item-icon {
		width: 16px;
		height: 16px;
		margin-right: 6px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.wind-file-item-name {
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.wind-file-tree-folder {
		padding-left: 0;
	}

	.wind-file-tree-folder .wind-file-item {
		padding-left: calc(16px + var(--folder-depth, 0) * 16px);
	}

	.wind-resize-handle {
		position: absolute;
		right: -4px;
		top: 0;
		bottom: 0;
		width: 8px;
		cursor: ew-resize;
		z-index: 10;
	}

	.wind-resize-handle:hover,
	.wind-resize-handle.resizing {
		background-color: var(--vscode-widget-border);
	}
</style>

<script>
	console.log("[Sidebar] Component initializing...");

	// Wait for Wind bootstrap to complete
	window.addEventListener('wind-bootstrap-complete', () => {
		console.log("[Sidebar] Initializing...");
		showFileTree();
	});

	function showFileTree() {
		const fileTreeContainer = document.getElementById('wind-file-tree');
		if (!fileTreeContainer) return;

		// Show mock file tree
		fileTreeContainer.innerHTML = `
			<div class="wind-file-tree-folder">
				<div class="wind-file-item active" data-path="/">
					<span class="wind-file-item-icon">📁</span>
					<span class="wind-file-item-name">WORKSPACE</span>
				</div>
			</div>
			<div class="wind-file-tree-folder" style="--folder-depth: 1px;">
				<div class="wind-file-item" data-path="/element">
					<span class="wind-file-item-icon">📂</span>
					<span class="wind-file-item-name">Element</span>
				</div>
				<div class="wind-file-item" data-path="/dependency">
					<span class="wind-file-item-icon">📂</span>
					<span class="wind-file-item-name">Dependency</span>
				</div>
				<div class="wind-file-item" data-path="/documentation">
					<span class="wind-file-item-icon">📂</span>
					<span class="wind-file-item-name">Documentation</span>
				</div>
			</div>
			<div class="wind-file-tree-folder" style="--folder-depth: 1px;">
				<div class="wind-file-item" data-path="/index.ts">
					<span class="wind-file-item-icon">📘</span>
					<span class="wind-file-item-name">index.ts</span>
				</div>
				<div class="wind-file-item" data-path="/package.json">
					<span class="wind-file-item-icon">📋</span>
					<span class="wind-file-item-name">package.json</span>
				</div>
				<div class="wind-file-item" data-path="/Readme.md">
					<span class="wind-file-item-icon">📝</span>
					<span class="wind-file-item-name">Readme.md</span>
				</div>
			</div>
		`;
	}

	// Handle file item clicks
	document.addEventListener('click', (event: Event) => {
		const target = event.target as HTMLElement;
		const item = target.closest('.wind-file-item') as HTMLElement;
		
		if (item && item.dataset['path']) {
			// Remove active class from all items
			document.querySelectorAll('.wind-file-item').forEach(el => {
				el.classList.remove('active');
			});
			
			// Add active class to clicked item
			item.classList.add('active');
			
			console.log("[Sidebar] File selected:", item.dataset['path']);
			
			// Get file name from path
			const path = item.dataset['path'];
			const name = item.querySelector('.wind-file-item-name')?.textContent || path?.split('/').pop() || '';
			const isFolder = item.querySelector('.wind-file-item-icon')?.textContent === '📂' || 
			                 item.querySelector('.wind-file-item-icon')?.textContent === '📁';
			
			// Dispatch custom event for editor to handle
			window.dispatchEvent(new CustomEvent('file-selected', {
				detail: {
					path: path,
					name: name,
					isFolder: isFolder,
				},
			}));
		}
	});

	// Handle sidebar resizing
	let isResizing = false;
	let startX = 0;
	let startWidth = 0;

	document.addEventListener('mousedown', (event: Event) => {
		const target = event.target as HTMLElement;
		if (target.classList.contains('wind-resize-handle')) {
			isResizing = true;
			startX = (event as MouseEvent).clientX;
			startWidth = (target.parentElement as HTMLElement).offsetWidth;
			target.classList.add('resizing');
		}
	});

	document.addEventListener('mousemove', (event: Event) => {
		if (!isResizing) return;
		
		const sidebar = document.querySelector('.wind-sidebar') as HTMLElement;
		const dx = (event as MouseEvent).clientX - startX;
		const newWidth = Math.max(150, Math.min(600, startWidth + dx));
		sidebar.style.width = `${newWidth}px`;
	});

	document.addEventListener('mouseup', (event: Event) => {
		const target = event.target as HTMLElement;
		if (isResizing) {
			isResizing = false;
			target.classList.remove('resizing');
		}
	});
</script>
