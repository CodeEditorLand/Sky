---
/**
 * Electron.astro - Direct Electron Workbench Entry Point
 *
 * This page provides direct access to the Electron workbench without
 * requiring environment variable configuration.
 *
 * Route: /Electron
 * Workbench: Electron (Electron workbench with polyfills)
 */

import Layout from "../Function/Markup/Base.astro";
import { Bust, On } from "../Function/Shared";
import ElectronWorkbench from "../Workbench/Electron/Layout.astro";
import WorkerBundleImports from "../Workbench/Electron/WorkerBundleImports.astro";

// Environment detection. `Bundle=true` is set by build profiles that
// resolve worker scripts via npm-package imports (Vite-bundled into a
// single chunk per page); `Bundle=false` profiles serve them as
// separately-fetched static assets at `/Worker/*.js`. The conditional
// below preserves both shapes.
const Bundle = process.env["Bundle"] === "true";

const Worker = `/Worker.js?BASE_REMOTE=${encodeURIComponent(Astro.url.origin)}`;
---

<Layout>
	<!-- Content Security Policy -->
	<meta
		http-equiv="Content-Security-Policy"
		content={((
			Configuration: Record<
				string,
				string[] | boolean | null | undefined
			>,
		): string => {
			const Policy: string[] = [];

			for (const Directive in Configuration) {
				if (
					Object.prototype.hasOwnProperty.call(
						Configuration,
						Directive,
					)
				) {
					const Value = Configuration[Directive];

					if (
						Value === null ||
						Value === undefined ||
						Value === false
					) {
						continue;
					}

					if (Value === true) {
						Policy.push(Directive);
					} else if (Array.isArray(Value) && Value.length > 0) {
						Policy.push(`${Directive} ${Value.join(" ")}`);
					}
				}
			}

			return Policy.join("; ");
		})({
			"default-src": ["'none'"],
			"img-src": [
				"'self'",
				"data:",
				"blob:",
				"vscode-remote-resource:",
				"vscode-managed-remote-resource:",
				"vscode-file:",
				"vscode-webview-resource:",
				"http://localhost:*",
				"https://tauri.localhost",
				"https:",
			],
			"manifest-src": [
				"'self'",
				"http://localhost:*",
				"https://tauri.localhost",
			],
			"media-src": [
				"'self'",
				"http://localhost:*",
				"https://tauri.localhost",
			],
			"frame-src": [
				"'self'",
				"vscode-webview:",
				"vscode-webview.net",
				"*.vscode-cdn.net",
				"*.vscode-webview.net",
				"http://localhost:*",
				"https://tauri.localhost",
			],
			"script-src": [
				"'self'",
				"'unsafe-inline'",
				"'unsafe-eval'",
				"blob:",
				"vscode-file:",
				"vscode-file://vscode-app",
				"http://localhost:*",
				"https://tauri.localhost",
				"https://eu-assets.i.posthog.com",
			],
			"style-src": [
				"'self'",
				"'unsafe-inline'",
				"vscode-file:",
				"http://localhost:*",
				"https://tauri.localhost",
			],
			"connect-src": [
				"'self'",
				"blob:",
				"ipc:",
				"vscode-file:",
				"vscode-file://vscode-app",
				"http://localhost:*",
				// Loopback IPv4 + IPv6 - covers the OTLP collector
				// (127.0.0.1:4318) when `Inspect=1` / `OTLPEnabled=true`
				// fires the exporter. Without these the workbench logs
				// `Refused to connect to http://127.0.0.1:4318/v1/traces`
				// CSP violations every flush window.
				"http://127.0.0.1:*",
				"https://tauri.localhost",
				"wss://tauri.localhost",
				"https:",
			],
			"font-src": [
				"'self'",
				"vscode-remote-resource:",
				"vscode-managed-remote-resource:",
				"http://localhost:*",
				"https://tauri.localhost",
			],
			"trusted-types": [
				"WorkerApplication",
				"amdLoader",
				"cellRendererEditorText",
				"chatDebugTokenizer",
				"defaultWorkerFactory",
				"diffEditorWidget",
				"diffReview",
				"domLineBreaksComputer",
				"dompurify",
				"editorGhostText",
				"editorViewLayer",
				"htmlToMarkdown",
				"notebookRenderer",
				"stickyScrollViewLayer",
				"tokenizeToString",
				"notebookChatEditController",
				"richScreenReaderContent",
				"collapsedCellPreview",
			],
			"block-all-mixed-content": true,
			"upgrade-insecure-requests": false,
		})}
		slot="Meta"
	/>

	<!-- VSCode Workbench Configuration -->
	<meta
		id="vscode-workbench-web-configuration"
		data-settings={JSON.stringify({
			remoteAuthority: "",
			serverBasePath: "/",
			connectionToken: "dummy-token",
			enableWorkspaceTrust: false,
			settingsSyncOptions: { enabled: false },
			productConfiguration: {
				embedderIdentifier: "browser",
				nameShort: "FIDDEE",
				nameLong: "FIDDEE",
				applicationName: "fiddee",
			},
			developmentOptions: {
				logLevel: On ? 2 : 0,
				enableSmokeTestDriver: On,
			},
		})}
		slot="Meta"
	/>

	<!-- VSCode Auth Session -->
	<meta
		id="vscode-workbench-auth-session"
		data-settings={JSON.stringify({})}
		slot="Meta"
	/>

	<!-- Global VSCode File Root -->
	<script is:inline slot="Head">
		globalThis._VSCODE_FILE_ROOT = `${window.location.origin}/Static/Application/`;
	</script>

	<!-- Worker Configuration -->
	<script
		is:inline
		type="module"
		define:vars={{ Worker: Bust(Worker) }}
		slot="Head"
	>
		// @ts-expect-error
		window._WORKER = Worker;
	</script>

	<!-- Bootstrap Configuration -->
	<script is:inline type="module" slot="Head" define:vars={{ On }}>
		// @ts-expect-error
		globalThis.__BOOTSTRAP_DEBUG__ = On;
	</script>

	{
		Bundle ? (
			<WorkerBundleImports />
		) : (
			<Fragment>
				<script
					is:inline
					type="module"
					src={Bust("/Worker/CSS/Load.js")}
				/>
				<script
					is:inline
					type="module"
					src={Bust("/Worker/Policy.js")}
				/>
				<script
					is:inline
					type="module"
					src={Bust("/Worker/Register.js")}
				/>
			</Fragment>
		)
	}

	<ElectronWorkbench />
</Layout>
