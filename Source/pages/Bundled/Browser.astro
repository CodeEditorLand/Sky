---
/**
 * Bundled/Browser.astro - Vite/Astro-bundled Browser workbench route.
 * Route: /Bundled/Browser
 * See Bundled/Electron.astro for the shared bundled-route contract.
 */

import Layout from "../../Function/Markup/Base.astro";

const BundledList = (process.env["Pack"] ?? "")
	.split(/\s+/)
	.map((Name) => Name.trim().toLowerCase())
	.filter(Boolean);

const BundledBrowserLayout = BundledList.includes("browser")
	? (await import("../../Workbench/Bundled/Browser/Layout.astro")).default
	: null;
---

<Layout>
	{BundledBrowserLayout ? <BundledBrowserLayout /> : null}
</Layout>
