---
/**
 * Bundled/Sessions.astro - Vite/Astro-bundled Sessions workbench route.
 * Route: /Bundled/Sessions
 * See Bundled/Electron.astro for the shared bundled-route contract.
 */

import Layout from "../../Function/Markup/Base.astro";

const BundledList = (process.env["Pack"] ?? "")
	.split(/\s+/)
	.map((Name) => Name.trim().toLowerCase())
	.filter(Boolean);

const BundledSessionsLayout = BundledList.includes("sessions")
	? (await import("../../Workbench/Bundled/Sessions/Layout.astro")).default
	: null;
---

<Layout>
	{BundledSessionsLayout ? <BundledSessionsLayout /> : null}
</Layout>
