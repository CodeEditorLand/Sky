---
/**
 * StatusBar - Bottom status information bar
 * 
 * Displays status information such as Git branch, cursor position,
 * encoding, language mode, etc.
 */
---
<div id="wind-statusbar" class="wind-statusbar">
	<!-- Left side status items -->
	<div class="wind-statusbar-left">
		<div class="wind-statusbar-item" title="Git Branch">
			<span class="statusbar-icon">⚡</span>
			<span class="statusbar-text">main</span>
		</div>
		<div class="wind-statusbar-item" title="Errors">
			<span class="statusbar-text error-count">✓ 0 Errors</span>
		</div>
		<div class="wind-statusbar-item" title="Warnings">
			<span class="statusbar-text warning-count">✓ 0 Warnings</span>
		</div>
	</div>
	
	<!-- Right side status items -->
	<div class="wind-statusbar-right">
		<div class="wind-statusbar-item" id="status-language" title="Language">TypeScript</div>
		<div class="wind-statusbar-item" id="status-encoding" title="Encoding">UTF-8</div>
		<div class="wind-statusbar-item" id="status-encoding" title="Line Ending">LF</div>
		<div class="wind-statusbar-item" id="status-cursor" title="Cursor Position">Ln 1, Col 1</div>
		<div class="wind-statusbar-item" title="Spaces">Spaces: 4</div>
	</div>
</div>

<style>
	.wind-statusbar {
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		background-color: var(--vscode-statusBar-foreground);
		border-top: 1px solid var(--vscode-statusBar-border);
		padding: 0 4px;
		font-size: 12px;
		font-weight: 500;
		color: var(--vscode-statusBar-foreground);
	}

	.wind-statusbar-left,
	.wind-statusbar-right {
		display: flex;
		align-items: center;
		gap: 0;
	}

	.wind-statusbar-item {
		display: flex;
		align-items: center;
		padding: 2px 8px;
		cursor: pointer;
		white-space: nowrap;
		transition: background-color 0.1s ease;
		border-radius: 2px;
	}

	.wind-statusbar-item:hover {
		background-color: var(--vscode-statusBarItem-hoverBackground);
	}

	.statusbar-icon {
		margin-right: 4px;
		font-size: 14px;
	}

	.statusbar-text {
		display: flex;
		align-items: center;
	}

	.statusbar-text.error-count {
		color: var(--vscode-statusBar-errorItem-foreground);
	}

	.statusbar-text.warning-count {
		color: var(--vscode-statusBar-warningItem-foreground);
	}

	.wind-statusbar-item.danger {
		color: var(--vscode-statusBarItem-dangerForeground);
		background-color: var(--vscode-statusBarItem-dangerBackground);
	}

	.wind-statusbar-item.warning {
		color: var(--vscode-statusBarItem-warningForeground);
	}
</style>

<script>
	console.log("[StatusBar] Component initializing...");

	// Listen for editor selection changes to update cursor position
	let updateCursorPosition: any = null;

	window.addEventListener('wind-bootstrap-complete', () => {
		console.log("[StatusBar] Bootstrap complete, ready for updates");
		
		// Try to Monaco editor cursor position
		const checkMonacoEditor = () => {
			// @ts-expect-error - Monaco global
			if (typeof monaco !== 'undefined' && monaco.editor) {
				// Find active Monaco editor
				const editors = document.querySelectorAll('.monaco-editor');
				if (editors.length > 0) {
					console.log("[StatusBar] Found Monaco editor");
					// Monaco editor is available
				}
			}
		};
		
		// Check periodically
		setInterval(checkMonacoEditor, 1000);
	});

	// Update cursor position (called from Editor)
	window.addEventListener('cursor-position-changed', (event: Event) => {
		const detail = (event as CustomEvent).detail;
		updateCursorPosition(detail.lineNumber, detail.column);
	});

	// Update language mode
	window.addEventListener('language-mode-changed', (event: Event) => {
		const detail = (event as CustomEvent).detail;
		const languageEl = document.getElementById('status-language');
		if (languageEl) {
			languageEl.textContent = detail.language;
		}
	});

	// Update encoding
	window.addEventListener('encoding-changed', (event: Event) => {
		const detail = (event as CustomEvent).detail;
		const encodingEl = document.getElementById('status-encoding');
		if (encodingEl) {
			encodingEl.textContent = detail.encoding;
		}
	});

	// Update cursor position UI
	updateCursorPosition = (line: number, column: number) => {
		const cursorEl = document.getElementById('status-cursor');
		if (cursorEl) {
			cursorEl.textContent = `Ln ${line}, Col ${column}`;
		}
	};

	// Click handlers for status bar items
	document.querySelectorAll('.wind-statusbar-item').forEach(item => {
		item.addEventListener('click', (event: Event) => {
			const target = event.currentTarget as HTMLElement;
			console.log("[StatusBar] Item clicked:", target.textContent);
			
			// Dispatch event for workbench to handle
			window.dispatchEvent(new CustomEvent('statusbar-item-clicked', {
				detail: {
					item: target.textContent?.trim(),
					title: target.getAttribute('title'),
				},
			}));
		});
	});
</script>
