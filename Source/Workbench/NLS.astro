---
/**
 * NLS preload.
 *
 * Stock VS Code's loader expects two files in the locale chain:
 *   - `vs/nls.js`            - the runtime that exposes `nls.localize` to
 *     module code (always present, generated by every VS Code build).
 *   - `nls.messages.js`      - per-locale string table (generated only by
 *     full localised builds; absent in source-tree builds and our Sky
 *     pipeline).
 *
 * Earlier this file flipped the conditional so production loads
 * pointed at a non-existent `/Static/Application/nls.messages.js`. The
 * server's catch-all returned the SPA HTML, the browser parsed it as
 * JS, and the workbench bootstrap blew up with
 * `SyntaxError: Unexpected token '<'`.
 *
 * We always preload `vs/nls.js`. The companion `nls.messages.js` request
 * the workbench's internal loader still emits is intercepted by the
 * static stub at `Public/Static/Application/nls.messages.js` so the 404
 * → HTML failure mode is gone in both dev and prod.
 */
import { Bust } from "../Function/Shared";
---

<script
	is:inline
	type="module"
	src={Bust(`/Static/Application/vs/nls.js`)}></script>
