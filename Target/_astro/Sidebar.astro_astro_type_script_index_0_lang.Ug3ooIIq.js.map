		const item = target.closest('.wind-file-item') as HTMLElement;
		
		if (item && item.dataset['path']) {
			// Remove active class from all items
			document.querySelectorAll('.wind-file-item').forEach(el => {
				el.classList.remove('active');
			});
			
			// Add active class to clicked item
			item.classList.add('active');
			
			console.log("[Sidebar] File selected:", item.dataset['path']);
			
			// Get file name from path
			const path = item.dataset['path'];
			const name = item.querySelector('.wind-file-item-name')?.textContent || path?.split('/').pop() || '';
			const isFolder = item.querySelector('.wind-file-item-icon')?.textContent === '📂' || 
