---
/**
 * WindWorkbench - Native Wind-based Workbench (Approach A4)
 *
 * Complexity: High
 * Feature Coverage: 60-70%
 * Trade-offs:
 * - Custom implementation using Wind Effect-TS services
 * - Full control over implementation
 * - Limited to available Wind services
 * - Requires building custom VSCode-like features
 * - No dependency on Electron workbench
 * - Long-term sustainability if Wind services expand
 *
 * A native implementation of the VSCode workbench using Wind's Effect-TS services.
 * This replaces the Electron-based workbench with a web-compatible version.
 *
 * Components:
 * - ActivityBar: Left-side navigation icons
 * - Sidebar: File explorer, search, etc.
 * - Editor: Monaco-based text editor
 * - Panel: Bottom panel for output/terminal
 * - StatusBar: Status information bar
 */

import NLS from "../NLS.astro";
import ActivityBar from "./ActivityBar.astro";
import Sidebar from "./Sidebar.astro";
import Editor from "./Editor.astro";
import Panel from "./Panel.astro";
import StatusBar from "./StatusBar.astro";
---

<Fragment>
	<!-- NLS (Natural Language Support) -->
	<NLS />

	<!-- Wind Preload Script -->
	<script type="module">
		import { Install } from "@codeeditorland/wind/Target/Function/Install";

		console.log("[WindWorkbench] Installing Wind preload...");
		
		Install()
			.then(() => {
				console.log("[WindWorkbench] ✓ Wind preload installed");
			})
			.catch((error) => {
				console.error("[WindWorkbench] ✗ Wind preload error:", error);
			});
	</script>

	<!-- Wind Effect-TS Bootstrap Script -->
	<script type="module">
		console.log("[WindWorkbench] Starting Wind bootstrap...");

		try {
			const { runBootstrap } = await import("@codeeditorland/wind/Target/Effect/Bootstrap");

			console.log("[WindWorkbench] ✓ Bootstrap module loaded");

			// Run the bootstrap with options
			const bootstrapResult = await runBootstrap({
				skipHealthCheck: true,
				debugMode: false,
			});

			if (bootstrapResult.success) {
				console.log("[WindWorkbench] ✓ Bootstrap completed successfully");
				console.log("[WindWorkbench]   - Total duration:", bootstrapResult.totalDuration, "ms");

				// Log individual stage results
				bootstrapResult.stages.forEach((stage: any) => {
					const status = stage.success ? "✓" : "✗";
					console.log(`[WindWorkbench]   - ${status} ${stage.stageName}: ${stage.duration}ms`);
				});
			} else {
				console.error("[WindWorkbench] ✗ Bootstrap failed:", bootstrapResult.error);
			}
		} catch (error) {
			console.error("[WindWorkbench] ✗ Failed to load/run bootstrap:", error);
		}

		console.log("[WindWorkbench] ===== Wind bootstrap sequence complete =====");
	</script>

	<!-- Workbench Layout -->
	<div id="wind-workbench" class="wind-workbench">
		<!-- Activity Bar (Leftmost icons) -->
		<ActivityBar />

		<!-- Main Content Area -->
		<div class="wind-workbench-main">
			<!-- Sidebar (File explorer, search, etc.) -->
			<Sidebar />

			<!-- Editor Area and Panel -->
			<div class="wind-workbench-center">
				<!-- Editor (Monaco-based) -->
				<Editor />

				<!-- Panel (Bottom output/terminal) -->
				<Panel />
			</div>
		</div>

		<!-- Status Bar (Bottom) -->
		<StatusBar />
	</div>

	<!-- Styles -->
	<style>
		/* CSS Reset and Base Styles */
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		html,
		body {
			width: 100%;
			height: 100%;
			overflow: hidden;
			font-family: var(--vscode-font-family);
			font-size: var(--vscode-font-size);
			background-color: var(--vscode-editor-background);
			color: var(--vscode-editor-foreground);
		}

		/* Workbench Container */
		.wind-workbench {
			display: flex;
			flex-direction: column;
			width: 100vw;
			height: 100vh;
			background-color: var(--vscode-sideBar-background);
		}

		/* Main Content Area */
		.wind-workbench-main {
			display: flex;
			flex: 1;
			overflow: hidden;
		}

		/* Center Area (Editor + Panel) */
		.wind-workbench-center {
			display: flex;
			flex-direction: column;
			flex: 1;
			overflow: hidden;
		}

		/* Scrollbar Styling */
		::-webkit-scrollbar {
			width: 10px;
			height: 10px;
		}

		::-webkit-scrollbar-track {
			background: var(--vscode-scrollbarSlider-background);
		}

		::-webkit-scrollbar-thumb {
			background: var(--vscode-scrollbarSlider-activeBackground);
			border-radius: 5px;
		}

		::-webkit-scrollbar-thumb:hover {
			background: var(--vscode-scrollbarSlider-hoverBackground);
		}

		/* Selection Color */
		::selection {
			background: var(--vscode-editor-selectionBackground);
			color: var(--vscode-editor-selectionForeground);
		}
	</style>

	<!-- Workbench Initialization Script -->
	<script>
		console.log("[WindWorkbench] Component mounted");

		// Wait for Wind bootstrap to complete
		window.addEventListener('wind-bootstrap-complete', async (event) => {
			console.log("[WindWorkbench] Bootstrap complete event received");
			const result = (event as any).detail;
			
			if (result.success) {
				console.log("[WindWorkbench] ✓ Initializing workbench services...");
			}
		});
	</script>
</Fragment>
