---
import Meta from "../Meta.astro";
---

<!doctype html>
<html lang="en" class="no-js" dir="ltr">
	<head>
		<!-- Early paint colour. Without this the WKWebView renders its
		     default white → VS Code's theme CSS → native-titlebar repaint
		     all in ~200 ms, visible as a purple/fuchsia/white flash on
		     every Tauri `Window.navigate()` reload (reported as
		     "overlaying purple windows" + stuttering). Matching VS Code
		     Dark+ (`#1e1e1e` editor bg, `#d4d4d4` editor fg) keeps the
		     first paint inside the app's dark band so the flash
		     disappears. Kept inline so it applies before any external
		     CSS loads. -->
		<style is:inline>
			html,
			body {
				background: #1e1e1e;
				color: #d4d4d4;
				margin: 0;
			}
		</style>

		<script>
			document.documentElement.classList.remove("no-js");

			document.documentElement.classList.add("js");
		</script>

		<Meta />

		<slot name="Meta" />

		<link
			rel="manifest"
			href="/Manifest.json"
			crossorigin="use-credentials"
		/>

		<!-- Global VSCode File Root - Must execute before module scripts -->
		<script is:inline>
			globalThis._VSCODE_FILE_ROOT = `${window.location.origin}/Static/Application/`;
			// Tells the Electron workbench to use relative imports
			// (resolves against http://localhost URL) instead of
			// vscode-file:// URLs that WKWebView can't import().
			globalThis._VSCODE_USE_RELATIVE_IMPORTS = true;
			// esbuild __name helper - required by Dependency/out/ files loaded in
			// extension host worker contexts that don't have their own __name definition.
			if (typeof globalThis.__name === "undefined") {
				Object.defineProperty(globalThis, "__name", {
					value: (Target, Value) =>
						Object.defineProperty(Target, "name", {
							value: Value,
							configurable: true,
						}),
					configurable: true,
					writable: true,
				});
			}
		</script>

		<slot name="Head" />

		<!-- Favicon -->
		<link
			rel="icon"
			type="image/png"
			href="/Favicon/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/Favicon/favicon.svg" />
		<link rel="shortcut icon" href="/Favicon/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/Favicon/apple-touch-icon.png"
		/>
		<link rel="manifest" href="/Favicon/site.webmanifest" />
	</head>

	<body aria-label="">
		<slot />
	</body>
</html>
