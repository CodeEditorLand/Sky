---
/**
 * Wind.astro - Native Wind-based Workbench Entry Point
 * 
 * This is the main entry point for the Wind workbench.
 * It loads Wind services and initializes the native UI components.
 * 
 * Unlike Default.astro (which loads the Electron workbench),
 * this loads a web-compatible native workbench using Wind services.
 */

import NativeWorkbench from "./Native/WindWorkbench.astro";
---

<Fragment>
	<!-- Load native Wind workbench -->
	<NativeWorkbench />
</Fragment>
