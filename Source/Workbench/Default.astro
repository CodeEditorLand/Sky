<!-- Wind Preload Script - Required for VSCode workbench -->
<script is:inline type="module" defer>
	import { Install } from "@codeeditorland/wind";

	// Install the Wind preload polyfill (window.vscode globals)
	// This must run before VSCode workbench.js which expects window.vscode
	Install().then(() => {
		console.log("[Sky] Wind preload installed successfully");
	}).catch((error) => {
		console.error("[Sky] Wind preload install error:", error);
	});
</script>

<!-- VSCode Workbench Script -->
<script>
	import "@codeeditorland/output/vs/code/electron-browser/workbench/workbench.js";
</script>
