---
/**
 * Bundled/Workbench.astro - Vite/Astro-bundled base workbench route.
 * Route: /Bundled/Workbench
 * See Bundled/Electron.astro for the shared bundled-route contract.
 */

import Layout from "../../Function/Markup/Base.astro";

const BundledList = (process.env["Pack"] ?? "")
	.split(/\s+/)
	.map((Name) => Name.trim().toLowerCase())
	.filter(Boolean);

const BundledWorkbenchLayout = BundledList.includes("workbench")
	? (await import("../../Workbench/Bundled/Workbench/Layout.astro")).default
	: null;
---

<Layout>
	{BundledWorkbenchLayout ? <BundledWorkbenchLayout /> : null}
</Layout>
